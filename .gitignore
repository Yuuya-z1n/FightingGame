# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
/[Ff]ighting [Gg]ame/.utmp/
/[Ff]ighting [Gg]ame/[Ll]ibrary/
/[Ff]ighting [Gg]ame/[Tt]emp/
/[Ff]ighting [Gg]ame/[Oo]bj/
/[Ff]ighting [Gg]ame/[Bb]uild/
/[Ff]ighting [Gg]ame/[Bb]uilds/
/[Ff]ighting [Gg]ame/[Ll]ogs/
/[Ff]ighting [Gg]ame/[Uu]ser[Ss]ettings/
/[Ff]ighting [Gg]ame/*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
/[Ff]ighting [Gg]ame/*.blend1
/[Ff]ighting [Gg]ame/*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Ff]ighting [Gg]ame/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Ff]ighting [Gg]ame/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Ff]ighting [Gg]ame/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
/[Ff]ighting [Gg]ame/*.DotSettings.user

# Visual Studio cache directory
/[Ff]ighting [Gg]ame/.vs/

# Gradle cache directory
/[Ff]ighting [Gg]ame/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/[Ff]ighting [Gg]ame/ExportedObj/
/[Ff]ighting [Gg]ame/.consulo/
/[Ff]ighting [Gg]ame/*.csproj
/[Ff]ighting [Gg]ame/*.unityproj
/[Ff]ighting [Gg]ame/*.sln
/[Ff]ighting [Gg]ame/*.slnx
/[Ff]ighting [Gg]ame/*.suo
/[Ff]ighting [Gg]ame/*.tmp
/[Ff]ighting [Gg]ame/*.user
/[Ff]ighting [Gg]ame/*.userprefs
/[Ff]ighting [Gg]ame/*.pidb
/[Ff]ighting [Gg]ame/*.booproj
/[Ff]ighting [Gg]ame/*.svd
/[Ff]ighting [Gg]ame/*.pdb
/[Ff]ighting [Gg]ame/*.mdb
/[Ff]ighting [Gg]ame/*.opendb
/[Ff]ighting [Gg]ame/*.VC.db

# Unity3D generated meta files
/[Ff]ighting [Gg]ame/*.pidb.meta
/[Ff]ighting [Gg]ame/*.pdb.meta
/[Ff]ighting [Gg]ame/*.mdb.meta

# Unity3D generated file on crash reports
/[Ff]ighting [Gg]ame/sysinfo.txt

# Mono auto generated files
/[Ff]ighting [Gg]ame/mono_crash.*

# Builds
/[Ff]ighting [Gg]ame/*.apk
/[Ff]ighting [Gg]ame/*.aab
/[Ff]ighting [Gg]ame/*.unitypackage
/[Ff]ighting [Gg]ame/*.unitypackage.meta
/[Ff]ighting [Gg]ame/*.app

# Crashlytics generated file
/[Ff]ighting [Gg]ame/crashlytics-build.properties

# TestRunner generated files
/[Ff]ighting [Gg]ame/InitTestScene*.unity*

# Addressables default ignores, before user customizations
/[Ff]ighting [Gg]ame/ServerData
/[Ff]ighting [Gg]ame/[Aa]ssets/StreamingAssets/aa*
/[Ff]ighting [Gg]ame/[Aa]ssets/AddressableAssetsData/link.xml*
/[Ff]ighting [Gg]ame/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Ff]ighting [Gg]ame/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Ff]ighting [Gg]ame/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Ff]ighting [Gg]ame/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Ff]ighting [Gg]ame/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Ff]ighting [Gg]ame/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Ff]ighting [Gg]ame/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
/[Ff]ighting [Gg]ame/[Aa]ssets/[Ss]ceneDependencyCache*
